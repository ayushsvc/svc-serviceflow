POSTGRES_DB=svc
POSTGRES_USER=svc
POSTGRES_PASSWORD=replace-with-a-long-random-password
DATABASE_URL=postgresql+asyncpg://svc:replace-with-a-long-random-password@db:5432/svc
REDIS_URL=redis://redis:6379/0
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-characters
ENVIRONMENT=development
DEBUG=false
CORS_ORIGINS=http://localhost:3000
SEED_ADMIN_PASSWORD=replace-before-first-start
SEED_TECHNICIAN_PASSWORD=replace-before-first-start
SEED_REQUESTER_PASSWORD=replace-before-first-start
SMTP_HOST=mailhog
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_STARTTLS=false
SMTP_USE_SSL=false
MAIL_FROM=no-reply@svcinfosys.in
APP_BASE_URL=http://localhost:3000
INVITATION_TTL_HOURS=24
INVITE_ALLOWED_EMAIL_DOMAINS=
INVITE_RATE_LIMIT=30
INVITE_RATE_WINDOW_SECONDS=3600
INVITE_ACCEPT_RATE_LIMIT=10
INVITE_ACCEPT_RATE_WINDOW_SECONDS=900
